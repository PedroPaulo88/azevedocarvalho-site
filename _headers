# O Cloudflare Pages serve CSS e JS com 4 horas de cache por padrão. Como o
# HTML vem sempre fresco (max-age=0), uma publicação que mude o estilo deixa
# quem já visitou com HTML novo e CSS velho por até 4 horas — na prática, o
# site quebrado. Aqui o navegador passa a revalidar sempre: quando nada muda
# a resposta é um 304 de poucos bytes, e quando muda chega na hora.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Imagens e ícones são estáveis: valem cache longo.
/imagens/*
  Cache-Control: public, max-age=2592000
